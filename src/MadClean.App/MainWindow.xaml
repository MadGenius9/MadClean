<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MadClean.App" xmlns:views="clr-namespace:MadClean.App.Views" x:Class="MadClean.App.MainWindow" x:Name="Shell" Title="MadClean" Width="1420" Height="1000" MinWidth="980" MinHeight="650" FontFamily="Segoe UI" FontSize="14" Foreground="#ECF1FB" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10212D" Offset="0"/><GradientStop Color="#0D1820" Offset="0.6"/><GradientStop Color="#142A3D" Offset="1"/></LinearGradientBrush></Window.Background>
    <Window.Resources>
        <Style x:Key="InspectionLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F2F6FF"/>
            <Setter Property="Padding" Value="6,20"/><Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="92"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="#284051" BorderThickness="0,0,0,1">
                            <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#172D3E"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#77CEFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Row" Property="Background" Value="#1D3B52"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="28,16,28,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M 5,34 L 5,6 L 20,21 L 35,6 L 35,34" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="42" Height="42" Margin="0,0,14,0">
                    <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#81D9FF" Offset="0"/><GradientStop Color="#269BEE" Offset="1"/></LinearGradientBrush></Path.Stroke>
                </Path>
                <TextBlock Text="MadClean" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="READ-ONLY INSPECTION" FontSize="11" Foreground="#A9BDD3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>
            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedPage}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <Button Content="Inspect this PC" Command="{Binding ScanCommand}" AutomationProperties.HelpText="Read local disks, temporary-file candidates, startup entries and Defender status"/>
                <Button Content="Check updates" Command="{Binding UpdatesCommand}" Background="#244159" Foreground="White" AutomationProperties.HelpText="Contact configured WinGet and Windows Update services for discovery only"/>
            </WrapPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="#294256" BorderThickness="0,0,0,1">
            <Grid Margin="28,0,28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="204"/></Grid.ColumnDefinitions>
                <ListBox SelectedIndex="{Binding PrimaryNavigationIndex, Mode=TwoWay}" ItemContainerStyle="{StaticResource TopNavigationItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Main navigation">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBoxItem Content="Overview" Tag="&#xE80F;" AutomationProperties.Name="Overview"/>
                    <ListBoxItem Content="Cleanup" Tag="&#xE8B7;" AutomationProperties.Name="Cleanup"/>
                    <ListBoxItem Content="Security" Tag="&#xE83D;" AutomationProperties.Name="Security"/>
                    <ListBoxItem Content="Startup" Tag="&#xE768;" AutomationProperties.Name="Startup"/>
                    <ListBoxItem Content="Updates" Tag="&#xE895;" AutomationProperties.Name="Updates"/>
                </ListBox>
                <ComboBox Grid.Column="1" Style="{StaticResource ToolSelector}" Tag="More tools" ItemsSource="{Binding ToolNavigationItems}" SelectedItem="{Binding SelectedToolNavigation, Mode=TwoWay}" DisplayMemberPath="Title" VerticalAlignment="Center" Margin="12,0,0,6"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#1A3652" BorderBrush="#426582" BorderThickness="0,0,0,1" Padding="24,12" Visibility="{Binding HasMadCleanReminder, Converter={StaticResource BooleanVisibility}}">
            <DockPanel><Button DockPanel.Dock="Right" Content="View MadClean update" Command="{Binding MadCleanReminderCommand}"/><TextBlock Text="{Binding MadCleanReminderText}" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/></DockPanel>
        </Border>
        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedPage}" Background="Transparent" BorderThickness="0">
            <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding ActualWidth, ElementName=Shell, Converter={StaticResource OverviewSideWidth}}"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Padding="72,46,46,28">
                                <StackPanel>
                                    <TextBlock FontSize="56" Margin="0,4,0,12" Foreground="#AFBED5"><Run Text="Your PC, " FontWeight="SemiBold" Foreground="#F4F8FF"/><Run Text="clearly understood"/></TextBlock>
                                    <TextBlock Text="A quick, read-only inspection of the key areas that affect your PC." Foreground="#ABBDD4" FontSize="17" Margin="0,0,0,30"/>
                                    <Button Style="{StaticResource InspectButton}" Command="{Binding ScanCommand}" ContentTemplate="{x:Null}" HorizontalAlignment="Left" MinWidth="380" MinHeight="74" AutomationProperties.Name="Inspect this PC" AutomationProperties.HelpText="Read local disk capacity, supported temporary-file candidates, startup entries and Defender status. Online updates require a separate action.">
                                        <StackPanel Orientation="Horizontal">
                                            <local:SymbolIcon Glyph="&#xE721;" FontSize="24" Foreground="White" Margin="0,0,18,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Inspect this PC" FontSize="22" Foreground="White" VerticalAlignment="Center"/>
                                            <local:SymbolIcon Glyph="&#xE72A;" FontSize="21" Foreground="#C9EDFF" Margin="28,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Read-only checks. You stay in control." FontSize="14" Foreground="#A9BCD4" Margin="0,16,0,30"/>
                                    <Border BorderBrush="#284051" BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <Button Style="{StaticResource InspectionLink}" Command="{Binding OpenCleanupPageCommand}" AutomationProperties.Name="Storage and temporary files: review cleanup preview">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
                                                    <local:SymbolIcon Glyph="&#xE7F1;" FontSize="30" Foreground="#D2DEF0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Storage &amp; temporary files" FontSize="19" Foreground="#F2F6FF"/>
                                                        <TextBlock Text="Check disk space and preview temporary files" FontSize="14" Foreground="#A9BDD3" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="16" Height="16" Stroke="#6582A4" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding CleanupSummary}" FontSize="14" Foreground="#77CEFF" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding CleanupMessage}"/></Grid>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource InspectionLink}" Command="{Binding OpenStartupPageCommand}" AutomationProperties.Name="Startup entries: review inventory">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
                                                    <local:SymbolIcon Glyph="&#xE768;" FontSize="30" Foreground="#D2DEF0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Startup entries" FontSize="19" Foreground="#F2F6FF"/>
                                                        <TextBlock Text="Review registered startup sources" FontSize="14" Foreground="#A9BDD3" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="16" Height="16" Stroke="#6582A4" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding StartupSummary}" FontSize="14" Foreground="#77CEFF" VerticalAlignment="Center" ToolTip="{Binding StartupMessage}"/></Grid>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource InspectionLink}" Command="{Binding OpenSecurityPageCommand}" AutomationProperties.Name="Microsoft Defender: review provider status">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
                                                    <local:SymbolIcon Glyph="&#xE83D;" FontSize="32" Foreground="#D2DEF0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="Microsoft Defender" FontSize="19" Foreground="#F2F6FF"/>
                                                        <TextBlock Text="Check current status and recorded findings" FontSize="14" Foreground="#A9BDD3" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="16" Height="16" Stroke="#6582A4" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding SecuritySummary}" FontSize="14" Foreground="#AFBED5" VerticalAlignment="Center" ToolTip="{Binding SecurityMessage}"/></Grid>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource InspectionLink}" Command="{Binding OpenUpdatesPageCommand}" AutomationProperties.Name="App and driver updates: open update discovery">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="146"/></Grid.ColumnDefinitions>
                                                    <local:SymbolIcon Glyph="&#xE895;" FontSize="30" Foreground="#D2DEF0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="App &amp; driver updates" FontSize="19" Foreground="#F2F6FF"/>
                                                        <TextBlock Text="Separate online check · coverage varies" FontSize="14" Foreground="#A9BDD3" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="16" Height="16" Stroke="#6582A4" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding UpdateSummary}" FontSize="14" Foreground="#AFBED5" VerticalAlignment="Center"/></Grid>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#294256">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Grid.Column" Value="1"/><Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CompactOverview}}" Value="True">
                                                <Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.Row" Value="1"/>
                                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#19374F" Offset="0"/><GradientStop Color="#101B24" Offset="0.8"/></LinearGradientBrush>
                                </Border.Background>
                                <Grid ClipToBounds="True">
                                    <Path Data="M 0,380 C 140,280 280,330 430,110" Stroke="#2983C4" StrokeThickness="20" Opacity="0.055" IsHitTestVisible="False"/>
                                    <StackPanel Margin="30,32,30,26">
                                        <TextBlock Text="Storage overview" FontSize="25" FontWeight="SemiBold"/>
                                        <TextBlock Text="Reported capacity for one drive." FontSize="14" Foreground="#A9BDD3" Margin="0,8,0,14"/>
                                        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedOverviewDisk, Mode=TwoWay}" DisplayMemberPath="Title" Tag="Select a drive" AutomationProperties.Name="Storage overview drive" HorizontalAlignment="Left" Width="200" Margin="0,0,0,14">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource ToolSelector}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Disks.Count}" Value="0"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <Grid Width="300" Height="300" HorizontalAlignment="Center" Margin="0,4,0,14">
                                            <local:StorageRing FreeFraction="{Binding StorageFreeFraction}"/>
                                            <StackPanel VerticalAlignment="Center" Margin="24,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StorageFreeText}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding StorageCapacityText}" FontSize="17" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                                                <TextBlock Text="Blue = free space" FontSize="12" Foreground="#9BB8D4" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding StorageScopeText}" Foreground="#A9BDD3" FontSize="13"/>
                                        <TextBlock Text="{Binding StorageCoverageText}" Foreground="#A9BDD3" FontSize="12" Margin="0,6,0,6"/>
                                        <Expander Header="Capacity source and check details" Margin="0,4,0,18">
                                            <TextBox Text="{Binding StorageFactDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="130" AutomationProperties.Name="Storage source, raw bytes, coverage and query time"/>
                                        </Expander>
                                        <Border BorderBrush="#294256" BorderThickness="0,1,0,0" Padding="0,24,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Before you start" FontSize="23" FontWeight="SemiBold"/>
                                                <TextBlock Text="Here’s what this inspection does." FontSize="14" Foreground="#A9BDD3" Margin="0,8,0,20"/>
                                                <Grid Margin="0,0,0,18">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <local:SymbolIcon Glyph="&#xE8A5;" FontSize="25" Foreground="#D2DEF0" VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1"><TextBlock Text="No files deleted" FontSize="16"/><TextBlock Text="A preview lists candidates; it does not prove they are junk." FontSize="12" Foreground="#A9BDD3" Margin="0,5,0,0"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,18">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <local:SymbolIcon Glyph="&#xE713;" FontSize="25" Foreground="#D2DEF0" VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1"><TextBlock Text="No updates installed" FontSize="16"/><TextBlock Text="Online discovery runs only when you choose Check updates." FontSize="12" Foreground="#A9BDD3" Margin="0,5,0,0"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <local:SymbolIcon Glyph="&#xE77B;" FontSize="25" Foreground="#D2DEF0" VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1"><TextBlock Text="Results need your review" FontSize="16"/><TextBlock Text="Read the source, limitations and findings before deciding." FontSize="12" Foreground="#A9BDD3" Margin="0,5,0,0"/></StackPanel>
                                                </Grid>
                                                <TextBlock Text="MadClean updates" Foreground="#A9BDD3" FontSize="12" Margin="0,12,0,2"/>
                                                <Button Content="{Binding MadCleanUpdateStatus}" Command="{Binding MadCleanReminderCommand}" Background="Transparent" Foreground="#7AD1FF" HorizontalAlignment="Left" Padding="0,4" Margin="0" FontSize="12" ToolTip="Review MadClean's user-controlled release checking"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Cleanup">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cleanup preview" Style="{StaticResource SectionTitle}"/>
                                <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding CleanupMessage}" Style="{StaticResource Caption}"/>
                                </ScrollViewer>
                                <TextBlock Text="Exact candidate paths and logical sizes from the two supported temporary roots only. Saved exclusions are honored before traversal. Known sharing conflicts are excluded; active use remains unknown, including memory-mapped use. This preview does not authorize deletion." Style="{StaticResource Caption}"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Content="Exclude selected file" Command="{Binding ExcludeCleanupFileCommand}"/>
                                    <Button Content="Exclude a folder…" Command="{Binding ExcludeCleanupFolderCommand}" Background="#244B70"/>
                                    <Button Content="Queued cleanup actions" Command="{Binding CapabilityQueueCommand}" Background="#343E52" Foreground="White"/>
                                </WrapPanel>
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CleanupCategories}" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding CleanupRows}" SelectedItem="{Binding SelectedCleanupRow, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="EXACT PATH" Binding="{Binding Name}" Width="3*" MinWidth="220"/>
                                    <DataGridTextColumn Header="SIZE / OBSERVATION" Binding="{Binding Detail}" Width="2*" MinWidth="190"/>
                                    <DataGridTextColumn Header="CATEGORY / RESULT" Binding="{Binding State}" Width="2*" MinWidth="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Expander Grid.Row="4" Header="Persistent exclusions" Foreground="#ECF1FB" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ExclusionsMessage}" Style="{StaticResource Caption}"/>
                                    <ListBox ItemsSource="{Binding CleanupExclusions}" SelectedItem="{Binding SelectedCleanupExclusion, Mode=TwoWay}" Height="95" Background="#171C27" Foreground="#ECF1FB" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6">
                                                    <TextBlock Text="{Binding Path}"/>
                                                    <TextBlock FontSize="11" Foreground="#A6B1C7">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Exact file"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IncludeDescendants}" Value="True">
                                                                        <Setter Property="Text" Value="Folder and descendants"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Remove selected exclusion" Command="{Binding RemoveCleanupExclusionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Background="#343E52" Foreground="White"/>
                                </StackPanel>
                            </Expander>
                            <StackPanel Grid.Row="3">
                                <TextBox Text="{Binding SelectedCleanupDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="78" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" Margin="0,10,0,0" AutomationProperties.Name="Full selected cleanup preview path and observation"/>
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Recheck the selected file" FontSize="20" Foreground="#ECF1FB"/>
                                        <TextBlock Text="Read current file information after refreshing temporary roots and saved exclusions. This reads no contents, scans no siblings and enables no deletion." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                        <Button Content="Recheck selected file" Command="{Binding RecheckCleanupFileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="Recheck selected cleanup file metadata"/>
                                        <TextBlock Text="{Binding CleanupFileEvidenceMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0" AutomationProperties.Name="Current cleanup file metadata status"/>
                                        <TextBox Text="{Binding CleanupFileEvidenceDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="126" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" Margin="0,10,0,0" AutomationProperties.Name="Current cleanup file metadata and uncertainty"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Startup">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Startup apps" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding StartupMessage}" Style="{StaticResource Caption}"/>
                            <ContentControl Height="320" Content="{Binding StartupRows}" ContentTemplate="{StaticResource RowsTemplate}"/>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Management actions are queued: exact entry selection, before/after preview and reversible enable/disable. Current inventory does not prove enabled state." Style="{StaticResource Caption}"/>
                                <Button Content="View capability queue" Command="{Binding CapabilityQueueCommand}" HorizontalAlignment="Left" Background="#343E52" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Security">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Microsoft Defender" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding SecurityMessage}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="MadClean reports Windows protection status and recorded findings. It is not an antivirus engine. No scan, remediation, quarantine or setting change is performed." Style="{StaticResource Caption}"/>
                            <ContentControl Height="320" Content="{Binding SecurityRows}" ContentTemplate="{StaticResource RowsTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Updates">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Update center" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Discovery and official guidance only. Apps, driver offers and BIOS/firmware evidence have separate coverage; an unchecked or unmatched item is never up to date." Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Foreground" Value="#CBD4E5"/>
                                    <Setter Property="Padding" Value="16,10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="Category" Background="#202838" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,6,8">
                                                    <ContentPresenter ContentSource="Header"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Category" Property="Background" Value="#31544D"/>
                                                        <Setter Property="Foreground" Value="#98D9FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Category" Property="BorderBrush" Value="#ECF1FB"/>
                                                        <Setter TargetName="Category" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>
                            <TabItem Header="Apps">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Matched installed-app updates" FontSize="20"/>
                                        <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding AppsMessage}" Style="{StaticResource Caption}"/>
                                        </ScrollViewer>
                                        <TextBlock Text="WinGet matched packages only. Unknown installed/available versions, missing source coverage and failed checks remain unknown." Style="{StaticResource Caption}"/>
                                        <ContentControl Content="{Binding AppRows}" ContentTemplate="{StaticResource RowsTemplate}" Height="230"/>
                                        <TextBlock Text="Windows software / unclassified offers" FontSize="18" Margin="0,18,0,0"/>
                                        <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding WindowsSoftwareMessage}" Style="{StaticResource Caption}"/>
                                        </ScrollViewer>
                                        <ContentControl Content="{Binding WindowsSoftwareRows}" ContentTemplate="{StaticResource RowsTemplate}" Height="170"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Drivers">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Driver discovery" FontSize="20"/>
                                        <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding DriverOffersMessage}" Style="{StaticResource Caption}"/>
                                        </ScrollViewer>
                                        <TextBlock Text="Source: configured Windows Update service. Use Check updates to query. Manufacturer driver catalogs are Unsupported in this increment; no installation or bulk replacement is performed." Style="{StaticResource Caption}"/>
                                        <ContentControl Content="{Binding DriverOfferRows}" ContentTemplate="{StaticResource RowsTemplate}" Height="300"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="BIOS / Firmware">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="BIOS / Firmware · guided review only" FontSize="20"/>
                                        <TextBlock Text="OEM PCs and laptops must use the OEM's exact model/SKU firmware, not a similarly named retail board. Reported identity is not proof of compatibility." Style="{StaticResource Caption}"/>
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Content="Read BIOS / PC identity" Command="{Binding ReadFirmwareIdentityCommand}"/>
                                            <Button Content="Official support guide" Command="{Binding OpenFirmwareSupportCommand}" Background="#244B70"/>
                                            <Button Content="Power / recovery precautions" Command="{Binding OpenFirmwarePrecautionsCommand}" Background="#343E52" Foreground="White"/>
                                        </WrapPanel>
                                        <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding FirmwareIdentityMessage}" Style="{StaticResource Caption}"/>
                                        </ScrollViewer>
                                        <TextBlock Text="{Binding FirmwareIdentityTime, StringFormat='Last identity attempt: {0}'}" FontSize="12" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding FirmwareIdentityRows}" SelectedItem="{Binding SelectedFirmwareFact, Mode=TwoWay}" Height="230">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="REPORTED FACT" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
                                                <DataGridTextColumn Header="VALUE" Binding="{Binding Detail}" Width="2*" MinWidth="150"/>
                                                <DataGridTextColumn Header="CIM / FIRMWARE SOURCE" Binding="{Binding State}" Width="3*" MinWidth="220"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBox Text="{Binding FirmwareFactDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="85" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" Margin="0,8,0,12"/>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FirmwareInstalledVersion, StringFormat='Installed reported BIOS version: {0}'}"/>
                                                <TextBlock Text="{Binding FirmwareAvailableVersion}" Margin="0,7,0,7"/>
                                                <TextBlock Text="{Binding FirmwareComparison}" Foreground="#A6B1C7"/>
                                                <TextBlock Text="Review official published release history below where supported; current-device BIOS applicability remains Unknown." Margin="0,7,0,7"/>
                                                <TextBlock Text="{Binding FirmwareGuideStatus}"/>
                                                <TextBlock Text="{Binding FirmwareOfficialSource}" FontSize="12" Margin="0,7,0,7"/>
                                                <TextBlock Text="{Binding FirmwarePrerequisites}" Foreground="#A6B1C7"/>
                                                <TextBlock Text="{Binding FirmwareManufacturerCheckTime}" FontSize="12" Margin="0,7,0,7"/>
                                                <TextBlock Text="{Binding FirmwareGuideAction}" Foreground="#98D9FF"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Official manufacturer release history" FontSize="18" Margin="0,14,0,8"/>
                                        <WrapPanel>
                                            <Button Content="Check supported official history" Command="{Binding CheckFirmwareHistoryCommand}"/>
                                            <Button Content="Review official release notes" Command="{Binding ReviewFirmwareHistorySourceCommand}" Background="#244B70"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding FirmwareHistoryMessage}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding FirmwareManufacturerCheckTime}" FontSize="12"/>
                                        <DataGrid ItemsSource="{Binding FirmwareHistoryRows}" SelectedItem="{Binding SelectedFirmwareRelease, Mode=TwoWay}" Height="175" Margin="0,8,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="PUBLISHED" Binding="{Binding PublishedDate}" Width="130"/>
                                                <DataGridTextColumn Header="OFFICIAL RELEASE" Binding="{Binding Heading}" Width="*"/>
                                                <DataGridTextColumn Header="PUBLISHED UEFI (IF STATED)" Binding="{Binding PublishedUefiVersion}" Width="220"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBox Text="{Binding FirmwareHistoryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="240" MinHeight="85" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8"/>
                                        <ItemsControl ItemsSource="{Binding FirmwareHistoryCoverage}" Margin="0,8,0,8">
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding FirmwareHistoryLinkMessage}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="Windows Update firmware-class offerings" FontSize="18" Margin="0,16,0,8"/>
                                        <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding FirmwareOffersMessage}" Style="{StaticResource Caption}"/>
                                        </ScrollViewer>

                                        <TextBlock Text="{Binding FirmwareOfferTime, StringFormat='Last Windows Update offer attempt: {0}'}" FontSize="12" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding FirmwareOffers}" SelectedItem="{Binding SelectedFirmwareOffer, Mode=TwoWay}" Height="180">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="OFFER TITLE (NOT A VERSION VERDICT)" Binding="{Binding Title}" Width="3*" MinWidth="230"/>
                                                <DataGridTextColumn Header="CLASS" Binding="{Binding DriverClass}" Width="*" MinWidth="90"/>
                                                <DataGridTextColumn Header="PACKAGE DATE" Binding="{Binding PackageDate}" Width="*" MinWidth="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBox Text="{Binding FirmwareOfferDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="145" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" Margin="0,10,0,12"/>
                                        <TextBlock Text="No firmware assets are bundled or fetched by MadClean. No flash, install, encryption-setting change, purchase or restart is performed. Hardware Upgrades offers explicit read-only inventory; manufacturer verification and advice remain queued. Detected facts do not establish upgrade limits." Style="{StaticResource Caption}"/>
                                        <Button Content="View incremental capability queue" Command="{Binding CapabilityQueueCommand}" HorizontalAlignment="Left" Background="#343E52" Foreground="White"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <TabItem Header="MadClean updates">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="MadClean updates" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Check the configured MadClean release source when you choose. Release notes and downloads open for your review; no automatic installation or restart." Style="{StaticResource Caption}"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="MadClean updates" FontSize="19" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MadCleanInstalledVersion, StringFormat='Installed version: {0}'}" Style="{StaticResource Caption}" Margin="0,5,0,4"/>
                                    <TextBlock Text="{Binding MadCleanUpdateStatus}" FontSize="16" Foreground="#98D9FF"/>
                                    <TextBlock Text="{Binding MadCleanUpdateMessage}" Style="{StaticResource Caption}" Margin="0,5,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Check MadClean updates" Command="{Binding MadCleanCheckCommand}"/>
                                        <Button Content="Release notes / download" Command="{Binding MadCleanReviewCommand}" Background="#244B70"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding MadCleanActionMessage}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                    <StackPanel Visibility="{Binding HasMadCleanReleaseNotes, Converter={StaticResource BooleanVisibility}}" Margin="0,8,0,0">
                                        <TextBlock Text="Release notes (plain text)" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding MadCleanReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="74" Background="#10141D" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" AutomationProperties.Name="MadClean release notes"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Private repository? Anonymous checking may be unavailable even if a release exists. Use the release page in your signed-in browser to review it manually. MadClean does not request, store or embed a GitHub token." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Installed apps"><views:InstalledAppsView/></TabItem>
                <TabItem Header="Disk space map">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Where are the known bytes?" Style="{StaticResource SectionTitle}"/>
                                <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding DiskMapMessage}" Style="{StaticResource Caption}"/>
                                </ScrollViewer>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Choose local folder…" Command="{Binding ChooseDiskMapFolderCommand}"/>
                                    <Button Content="Drill into selected folder" Command="{Binding DrillDiskMapCommand}" Background="#244B70"/>
                                    <Button Content="Up" Command="{Binding UpDiskMapCommand}" Background="#343E52" Foreground="White"/>
                                    <Button Content="Reset view" Command="{Binding ResetDiskMapCommand}" Background="#343E52" Foreground="White"/>
                                </WrapPanel>
                                <ScrollViewer MaxHeight="42" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding DiskMapPath}" FontWeight="SemiBold"/>
                                </ScrollViewer>
                                <TextBlock Text="{Binding DiskMapKnownBytes}" Margin="0,5,0,5"/>
                                <TextBlock Text="Area = known logical bytes in the current folder. Colors separate entries; they do not mean junk. Largest 119 entries plus an Other aggregate; all children remain in the linked list." Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:DiskSpaceMap Node="{Binding DiskMapCurrent}" SelectedNode="{Binding SelectedDiskNode, Mode=TwoWay}" NavigateCommand="{Binding DrillDiskMapCommand}" MinHeight="130" AutomationProperties.Name="Disk usage by known logical bytes"/>
                                <ListBox Grid.Column="2" ItemsSource="{Binding DiskMapChildren}" SelectedItem="{Binding SelectedDiskNode, Mode=TwoWay}" Background="#171C27" Foreground="#ECF1FB" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="All children and exact sizes">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="7">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding Bytes, Converter={StaticResource ByteSize}}" FontSize="12" Foreground="#A6B1C7"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <TextBox Text="{Binding DiskMapSelection, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="105" MinHeight="46" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8"/>
                                <Expander Header="Skipped / unknown-size observations" Foreground="#ECF1FB">
                                    <ContentControl Content="{Binding DiskMapIssues}" ContentTemplate="{StaticResource RowsTemplate}" Height="120"/>
                                </Expander>
                                <Expander Header="Observed hard-link identity accounting · optional metadata check" Foreground="#ECF1FB" Margin="0,12,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <Button Content="Analyze snapshot file identities" Command="{Binding AnalyzeDiskIdentitiesCommand}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding DiskIdentityMessage}" Style="{StaticResource Caption}" Margin="0,8,0,8"/>
                                        <TextBox Text="{Binding DiskIdentityTotals, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="115" MinHeight="60" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8"/>
                                        <ContentControl Content="{Binding DiskIdentityRows}" ContentTemplate="{StaticResource RowsTemplate}" Height="220" Margin="0,10,0,8"/>
                                        <ItemsControl ItemsSource="{Binding DiskIdentityCoverage}">
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Leftover review">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Leftover candidates · review only" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding ApplicationBaselineMessage}" Style="{StaticResource Caption}"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Capture baseline" Command="{Binding CaptureApplicationBaselineCommand}"/>
                                    <Button Content="Review registration changes" Command="{Binding ReviewLeftoversCommand}" Background="#244B70"/>
                                    <Button Content="Preview selected folder contents" Command="{Binding PreviewLeftoverContentsCommand}" Background="#244B70"/>
                                    <Button Content="Queued actions" Command="{Binding CapabilityQueueCommand}" Background="#343E52" Foreground="White"/>
                                </WrapPanel>
                                <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding LeftoverMessage}" Style="{StaticResource Caption}"/>
                                </ScrollViewer>
                                <TextBlock Text="Only surviving previously recorded local install folders are considered after complete inventories. Missing registrations do not prove uninstall completion. Shared dependencies, data, saves and settings are never automatically removed." Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding LeftoverCandidates}" SelectedItem="{Binding SelectedLeftoverCandidate, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CANDIDATE PATH" Binding="{Binding Path}" Width="2*" MinWidth="200"/>
                                    <DataGridTextColumn Header="EVIDENCE" Binding="{Binding Evidence}" Width="2*" MinWidth="180"/>
                                    <DataGridTextColumn Header="CAUTION" Binding="{Binding Caution}" Width="3*" MinWidth="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <TextBox Text="{Binding SelectedLeftoverDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="105" MinHeight="46" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8"/>
                                <TextBlock Text="Selected-folder metadata preview" FontSize="19" Margin="0,18,0,5"/>
                                <TextBlock Text="{Binding LeftoverContentAttempt, StringFormat='Last attempt: {0}'}" FontSize="12"/>
                                <TextBlock Text="{Binding LeftoverContentMessage}" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding LeftoverContentScope, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="100" MinHeight="46" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8"/>
                                <DataGrid ItemsSource="{Binding LeftoverContentRows}" SelectedItem="{Binding SelectedLeftoverContent, Mode=TwoWay}" Height="235" Margin="0,10,0,10" AutomationProperties.Name="Selected former install-folder metadata observations">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="OBSERVED PATH" Binding="{Binding Path}" Width="3*" MinWidth="220"/>
                                        <DataGridCheckBoxColumn Header="DIRECTORY" Binding="{Binding IsDirectory}" Width="105"/>
                                        <DataGridTextColumn Header="LOGICAL SIZE" Binding="{Binding Bytes, Converter={StaticResource ByteSize}}" Width="130"/>
                                        <DataGridTextColumn Header="ACTIVE USE" Binding="{Binding ActiveUse}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox Text="{Binding LeftoverContentDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="210" MinHeight="65" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8"/>
                                <ItemsControl ItemsSource="{Binding LeftoverContentCoverage}" Margin="0,8,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Expander Header="Excluded / unknown metadata observations" Foreground="#ECF1FB"><ContentControl Content="{Binding LeftoverContentIssues}" ContentTemplate="{StaticResource RowsTemplate}" Height="150"/></Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Capability queue">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Available discovery &amp; queued actions" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="The phase-one foundation remains read-only. Later system changes require exact previews and explicit user selection. This queue records scope; it does not execute operations." Style="{StaticResource Caption}"/>
                            <ItemsControl ItemsSource="{Binding Capabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Capability}" FontSize="19" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Discovery}" Foreground="#98D9FF" Margin="0,8,0,8"/>
                                                <TextBlock Text="{Binding NextStep}" Foreground="#ABC1F5" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding RequiredReview}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Activity">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Activity" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Local operation events only. No filenames, startup commands, detection resources or provider output are written to the log. Two bounded log files, approximately 1 MB each." Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding LogMessage}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Activity}" Background="#171C27" Foreground="#C5D1E6" BorderThickness="0" Padding="14"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Hardware Upgrades">
                    <ScrollViewer Margin="28,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Hardware Upgrades" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Detected facts first. Compatibility needs separate evidence." FontSize="19" Margin="0,0,0,12"/>
                            <TextBlock Text="Read-only PC, motherboard, CPU, RAM, GPU and storage observations. Windows/firmware may report incomplete or inaccurate values; detected hardware is not proof an upgrade is supported." Style="{StaticResource Caption}"/>
                            <Button Content="Read hardware inventory" Command="{Binding ReadHardwareCommand}" HorizontalAlignment="Left" Margin="0,12,0,12"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding HardwareMessage}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding HardwareAttemptTime, StringFormat='Last local query attempt: {0}'}" FontSize="12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataGrid ItemsSource="{Binding HardwareFacts}" SelectedItem="{Binding SelectedHardwareFact, Mode=TwoWay}" Height="310" AutomationProperties.Name="Detected hardware facts">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                                    <DataGridTextColumn Header="Component" Binding="{Binding Component}" Width="115"/>
                                    <DataGridTextColumn Header="Reported property" Binding="{Binding Property}" Width="*"/>
                                    <DataGridTextColumn Header="Reported value" Binding="{Binding Value}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Text="{Binding HardwareFactDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="125" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" Margin="0,12,0,12" AutomationProperties.Name="Selected hardware fact and source"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding HardwareIdentityReferenceSummary}" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding HardwareIdentityReferenceDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" AutomationProperties.Name="Bundled identity source and verification limits"/>
                                    <TextBlock Text="Upgrade compatibility limits: Unknown / not verified" FontSize="17"/>
                                    <TextBlock Text="Exact-model/revision RAM limits/types, supported CPUs and required BIOS, expansion and storage specifications are queued. Reported board version is not a verified PCB revision; reported device entries do not establish free physical slots or upgradeability." Style="{StaticResource Caption}" Margin="0,8,0,8"/>
                                    <TextBlock Text="Manual checks required" FontSize="17"/>
                                    <TextBlock Text="PSU capacity/connectors, case/GPU clearance, free physical slots and soldered-memory upgradeability remain Unknown. Budget/use-case advice is queued until compatibility can be verified. No purchases, firmware updates or other hardware changes run here." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <views:ManufacturerServiceView/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            <TabItem Header="Duplicate review"><views:DuplicateReviewView/></TabItem>
            <TabItem Header="Shortcut review"><views:ShortcutReviewView/></TabItem>
            <TabItem Header="Windows Diagnostics"><views:DiagnosticsView/></TabItem>
            <TabItem Header="Guided Windows workflows"><views:GuidedWindowsView/></TabItem>
            <TabItem Header="Windows integrity tools"><views:SystemToolsView/></TabItem>
            <TabItem Header="Startup recovery previews"><views:StartupActionsView/></TabItem>
        </TabControl>
        <Border Grid.Row="4" BorderBrush="#294256" BorderThickness="0,1,0,0" Background="#162A3B" Padding="28,10">
            <StackPanel>
                <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="2" Foreground="#44B4FF" Background="#263E54" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Command="{Binding OpenActivityPageCommand}" Background="Transparent" Foreground="#8FD7FF" Padding="8" Margin="0" AutomationProperties.Name="Open activity log">
                        <StackPanel Orientation="Horizontal"><local:SymbolIcon Glyph="&#xE9D9;" FontSize="20" Foreground="#D2DEF0" Margin="0,0,18,0" VerticalAlignment="Center"/><TextBlock Text="Activity log" Foreground="#8FD7FF" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="20,0" Foreground="#A9BDD3" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    <Button Grid.Column="2" Content="Cancel inspection / check" Command="{Binding CancelCommand}" Background="#244159" Foreground="White" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
