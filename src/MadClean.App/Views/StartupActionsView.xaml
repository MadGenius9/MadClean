<UserControl x:Class="MadClean.App.Views.StartupActionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">
            <TextBlock Text="Startup recovery previews" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Review one current-user registration or recovery record." FontSize="19" Margin="0,0,0,10"/>
            <TextBlock Text="The action mechanism is being validated separately. Production changes are disabled. These reads and previews do not modify Run/RunOnce, StartupApproved, machine startup entries or Startup folders, and never execute discovered commands." Style="{StaticResource Caption}"/>
            <WrapPanel><Button Content="Read covered registrations" Command="{Binding ReadStartupRegistrationsCommand}"/><Button Content="Read recovery record metadata" Command="{Binding ReadStartupBackupsCommand}"/></WrapPanel>
            <TextBlock Text="{Binding StartupRegistrationQueryDetails}" Style="{StaticResource Caption}" Margin="0,10,0,0" AutomationProperties.Name="Startup registration request, response and coverage"/>
            <DataGrid ItemsSource="{Binding StartupRegistrations}" SelectedItem="{Binding SelectedStartupRegistration, Mode=TwoWay}" AutoGenerateColumns="False" Height="170" Margin="0,12,0,8" AutomationProperties.Name="Covered current-user startup registrations"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="190"/><DataGridTextColumn Header="Registration value name" Binding="{Binding ValueName}" Width="*"/></DataGrid.Columns></DataGrid>
            <Button Content="Preview selected registration change" Command="{Binding PreviewStartupDisableCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding StartupBackupQueryDetails}" Style="{StaticResource Caption}" Margin="0,10,0,0" AutomationProperties.Name="Recovery metadata request, response and uncertainty"/>
            <DataGrid ItemsSource="{Binding StartupBackups}" SelectedItem="{Binding SelectedStartupBackup, Mode=TwoWay}" AutoGenerateColumns="False" Height="150" Margin="0,12,0,8" AutomationProperties.Name="MadClean recovery metadata"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding Reference.Source}" Width="190"/><DataGridTextColumn Header="Value name" Binding="{Binding Reference.ValueName}" Width="*"/><DataGridTextColumn Header="Recorded recovery state" Binding="{Binding RecoveryState}" Width="*"/></DataGrid.Columns></DataGrid>
            <Button Content="Preview selected recovery record" Command="{Binding PreviewStartupRestoreCommand}" HorizontalAlignment="Left"/>
            <TextBox Text="{Binding StartupActionDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="280" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact startup recovery preview and limitations"/>
            <TextBlock Text="{Binding StartupActionMessage}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="Restore must preserve any existing registration. A saved backup does not by itself prove that a change completed. Changes stay disabled until the Windows recovery checks pass." Style="{StaticResource Caption}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
