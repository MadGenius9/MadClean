<UserControl x:Class="MadClean.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MadClean.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24">
            <TextBlock Text="Windows Diagnostics" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Inspection observations and existing event evidence." FontSize="19" Margin="0,0,0,10"/>
            <views:ComponentStoreStatusView/>
            <Border Style="{StaticResource Card}" Margin="0,8,0,16"><StackPanel>
                <TextBlock Text="Inspection evidence · this session" FontSize="20"/>
                <TextBlock Text="Five independent sources from requests in this session: disk space and Defender from Inspect this PC, plus separately confirmed component-store recorded flags, fresh component-store scan, and SFC client observations. This panel starts no queries. Each source keeps its own time, coverage and uncertainty; Available is not a healthy-PC verdict. Event and WER windows below are separate." Style="{StaticResource Caption}"/>
                <DataGrid ItemsSource="{Binding InspectionEvidenceRows}" SelectionMode="Single" IsSynchronizedWithCurrentItem="False" SelectedItem="{Binding SelectedInspectionEvidence, Mode=TwoWay}" Height="210" AutomationProperties.Name="Local inspection evidence and source states"><DataGrid.Columns>
                    <DataGridTextColumn Header="AREA" Binding="{Binding Title}" Width="200"/>
                    <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="120"/>
                    <DataGridTextColumn Header="OBSERVATION" Binding="{Binding Observation}" Width="*" MinWidth="220"/>
                    <DataGridTextColumn Header="COLLECTED UTC" Binding="{Binding CompletedUtc, StringFormat=u}" Width="180"/>
                </DataGrid.Columns></DataGrid>
                <TextBox Text="{Binding InspectionEvidenceDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="210" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" AutomationProperties.Name="Inspection source, time, uncertainty and impact"/>
            </StackPanel></Border>
            <TextBlock Text="Read bounded local Application/System metadata for reported warning/error/critical events and supported WER records. Counts refer to event records, not unique crashes or confirmed causes. No Security log, messages, payloads, dump contents, integrity check or repair is collected or started." Style="{StaticResource Caption}"/>
            <WrapPanel Margin="0,4,0,12">
                <ComboBox ItemsSource="{Binding DiagnosticRanges}" SelectedItem="{Binding SelectedDiagnosticRange, Mode=TwoWay}" DisplayMemberPath="Title" Tag="Choose time range" Width="190" Margin="0,0,12,0" AutomationProperties.Name="Diagnostic evidence time range">
                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource ToolSelector}"/></ComboBox.Style>
                </ComboBox>
                <Button Content="Read event evidence" Command="{Binding ReadDiagnosticsCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding DiagnosticsAttempt, StringFormat='Last attempt: {0}'}" Foreground="#A9BDD3" FontSize="12"/>
            <TextBlock Text="Changing the time range clears old event/WER results. An existing read may still finish; choose Read again after it settles to check the new range." Style="{StaticResource Caption}"/>
            <TextBlock Text="{Binding DiagnosticsMessage}" Style="{StaticResource Caption}"/>
            <TextBlock Text="{Binding DiagnosticsWindow}" Style="{StaticResource Caption}"/>
            <Border Style="{StaticResource Card}" Margin="0,8,0,12"><StackPanel>
                <TextBlock Text="Event source coverage" FontSize="20"/>
                <TextBlock Text="Each channel keeps its own status. Usable matching records are counted before the finding-group limit. Whole-log counts and retention probes are separate observations, not unique crashes or complete history. Unknown is never zero." Style="{StaticResource Caption}"/>
                <DataGrid ItemsSource="{Binding DiagnosticChannelRows}" SelectedItem="{Binding SelectedDiagnosticChannel, Mode=TwoWay}" IsReadOnly="True" SelectionMode="Single" IsSynchronizedWithCurrentItem="False" Height="115" AutomationProperties.Name="Application and System event query coverage"><DataGrid.Columns>
                    <DataGridTextColumn Header="CHANNEL" Binding="{Binding Channel}" Width="110"/>
                    <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="110"/>
                    <DataGridTextColumn Header="USABLE MATCHING" Binding="{Binding UsableMatchingRecords, TargetNullValue=Unknown}" Width="*" MinWidth="145"/>
                    <DataGridTextColumn Header="LIMIT REACHED" Binding="{Binding Truncated, TargetNullValue=Unknown}" Width="135"/>
                    <DataGridTextColumn Header="WHOLE-LOG COUNT" Binding="{Binding WholeLogRecordCount, TargetNullValue=Unknown}" Width="160"/>
                    <DataGridTextColumn Header="RETENTION PROBE" Binding="{Binding RetentionState}" Width="150"/>
                </DataGrid.Columns></DataGrid>
                <TextBox Text="{Binding DiagnosticChannelDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="145" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" AutomationProperties.Name="Selected event channel status, limits and retention uncertainty"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,8,0,12"><StackPanel>
                <TextBlock Text="Observed recurrence" FontSize="20"/>
                <TextBlock Text="{Binding DiagnosticRecurrence}" Style="{StaticResource Caption}"/>
                <CheckBox IsChecked="{Binding RepeatedDiagnosticsOnly, Mode=TwoWay}" Foreground="#ECF1FB" AutomationProperties.Name="Filter existing event observations to repeated groups">
                    <TextBlock Text="Show repeated observations only (two or more event records)" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Text="Repeated records may describe the same incident. WER store references below are separate evidence and are never added to these totals. An empty filtered list does not mean no errors or a healthy system." Style="{StaticResource Caption}"/>
            </StackPanel></Border>
            <DataGrid ItemsSource="{Binding DiagnosticFindingsView}" SelectedItem="{Binding SelectedDiagnosticFinding, Mode=TwoWay}" Height="300" AutomationProperties.Name="Recurring event observations">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CHANNEL" Binding="{Binding Channel}" Width="105"/>
                    <DataGridTextColumn Header="PROVIDER" Binding="{Binding Provider}" Width="2*" MinWidth="200"/>
                    <DataGridTextColumn Header="EVENT ID" Binding="{Binding EventId}" Width="90"/>
                    <DataGridTextColumn Header="REPORTED LEVEL" Binding="{Binding Level}" Width="130"/>
                    <DataGridTextColumn Header="RECORDS" Binding="{Binding Count}" Width="90"/>
                    <DataGridTextColumn Header="LAST UTC" Binding="{Binding LastUtc, StringFormat=u}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox Text="{Binding DiagnosticDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="235" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" AutomationProperties.Name="Selected event evidence, uncertainty and impact"/>
            <Expander Header="Requested/read sources, retention, limits and gaps" IsExpanded="True"><ItemsControl ItemsSource="{Binding DiagnosticCoverage}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#A9BDD3" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
            <Border Style="{StaticResource Card}" Margin="0,20,0,12"><StackPanel>
                <TextBlock Text="Windows Error Reporting store evidence" FontSize="20"/>
                <TextBlock Text="Optional machine queue/archive metadata only, through supported WER Store APIs. Report references use the selected time range above; separately queried current-store counts cover all creation times. This does not decode raw report signatures, application names, report files or dumps, and never submits, purges or changes reports." Style="{StaticResource Caption}"/>
                <Button Content="Read WER metadata" Command="{Binding ReadWerMetadataCommand}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding WerMessage}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding WerWindow}" Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding WerCountSummary}" Style="{StaticResource Caption}" AutomationProperties.Name="WER current-store counts and uncertainty"/>
                <DataGrid ItemsSource="{Binding WerRows}" SelectedItem="{Binding SelectedWerObservation, Mode=TwoWay}" Height="200" AutomationProperties.Name="Stored WER report metadata"><DataGrid.Columns><DataGridTextColumn Header="STORE" Binding="{Binding Store}" Width="160"/><DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="CREATED UTC" Binding="{Binding CreatedUtc, StringFormat=u}" Width="180"/></DataGrid.Columns></DataGrid>
                <TextBox Text="{Binding WerDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="230" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" AutomationProperties.Name="Selected WER metadata source, time and uncertainty"/>
                <ItemsControl ItemsSource="{Binding WerCoverage}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#A9BDD3" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <TextBlock Text="No matching records does not mean healthy. Unexpected-shutdown events alone do not diagnose a PSU, RAM or driver fault. Component-store tools separately offer recorded flags or a fresh scan after review and confirmation; neither requests repair. The fixed SFC verify-only request is separately available after identity review and confirmation; its client observations do not establish file integrity. Repairs remain disabled. Ordinary inventory never runs DISM or SFC." Style="{StaticResource Caption}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
