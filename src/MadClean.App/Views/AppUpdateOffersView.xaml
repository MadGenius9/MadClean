<UserControl x:Class="MadClean.App.Views.AppUpdateOffersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Matched installed-app updates" FontSize="20"/>
            <Border Background="#172F42" BorderBrush="#35516B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,8">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Check: " Foreground="#AFC4D8"/>
                        <TextBlock Text="{Binding AppUpdateQueryState}" Margin="0,0,18,0" AutomationProperties.AutomationId="AppUpdateQueryState"/>
                        <TextBlock Text="Available: " Foreground="#AFC4D8"/>
                        <TextBlock Text="{Binding AppUpdateAvailableCount}" Margin="0,0,18,0" AutomationProperties.AutomationId="AppUpdateAvailableCount"/>
                        <TextBlock Text="Unknown: " Foreground="#AFC4D8"/>
                        <TextBlock Text="{Binding AppUpdateUnknownCount}" Margin="0,0,18,0" AutomationProperties.AutomationId="AppUpdateUnknownCount"/>
                        <TextBlock Text="Catalog rows: " Foreground="#AFC4D8"/>
                        <TextBlock Text="{Binding AppUpdateCatalogCount}" AutomationProperties.AutomationId="AppUpdateCatalogCount"/>
                    </WrapPanel>
                    <TextBlock Text="Last attempt (UTC)" Foreground="#AFC4D8" Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding AppUpdateCheckedUtc}" AutomationProperties.AutomationId="AppUpdateCheckedUtc"/>
                    <TextBlock Text="{Binding AppUpdateOwnershipStatus}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#AFC4D8" AutomationProperties.AutomationId="AppUpdateOwnership" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding AppsMessage}" Style="{StaticResource Caption}" AutomationProperties.Name="WinGet matched package source status" AutomationProperties.LiveSetting="Polite"/>
            </ScrollViewer>
            <TextBlock Text="WinGet matched packages only. A successful listing does not mean every application was checked. Per-package Unknown is never an up-to-date claim; reported source labels do not verify publishers or package authenticity." Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding AppUpdateOfferQueryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="145" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10" AutomationProperties.Name="WinGet offer source and query attempt times"/>
            <DataGrid ItemsSource="{Binding AppUpdateOffers}" SelectedItem="{Binding SelectedAppUpdateOffer, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" Height="230" AutomationProperties.Name="Actual WinGet matched package observations">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MATCHED PACKAGE" Binding="{Binding Name}" Width="2*" MinWidth="170"/>
                    <DataGridTextColumn Header="INSTALLED (REPORTED)" Binding="{Binding InstalledVersion}" Width="*" MinWidth="135"/>
                    <DataGridTextColumn Header="AVAILABLE (REPORTED)" Binding="{Binding AvailableVersion}" Width="*" MinWidth="135"/>
                    <DataGridTextColumn Header="PACKAGE STATUS" Binding="{Binding Status}" Width="*" MinWidth="115"/>
                    <DataGridTextColumn Header="SOURCE LABEL" Binding="{Binding Source}" Width="*" MinWidth="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Selected package · evidence and unknowns" FontSize="18" Margin="0,16,0,8"/>
            <TextBox Text="{Binding AppUpdateOfferDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="235" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected WinGet package versions, source and unknown prerequisites"/>
            <Border Style="{StaticResource Card}" Margin="0,16,0,8">
                <StackPanel>
                    <TextBlock Text="Selected offered-version catalog metadata" FontSize="19" Margin="0,0,0,8"/>
                    <TextBlock Text="Separate explicit online read: rechecks the selected package ID, installed/offered versions and fixed WinGet source, then may fetch/cache manifest metadata. No package binary, agreement acceptance, installation or restart is requested. Changing selection clears this review." Style="{StaticResource Caption}"/>
                    <Button Content="Read selected catalog metadata" AutomationProperties.AutomationId="ReadAppPackageMetadata" Command="{Binding ReadAppPackageMetadataCommand}" HorizontalAlignment="Left" Margin="0,12,0,10" AutomationProperties.Name="Read selected offered-version catalog metadata online without installing"/>
                    <TextBlock Text="{Binding AppPackageMetadataMessage}" Style="{StaticResource Caption}" AutomationProperties.Name="Selected catalog metadata status and limitations" AutomationProperties.LiveSetting="Polite"/>
                    <TextBox AutomationProperties.AutomationId="AppPackageMetadataQueryDetails" Text="{Binding AppPackageMetadataQueryDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,8,0,10" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" AutomationProperties.Name="Selected catalog metadata source, scope and request times"/>
                    <TextBox AutomationProperties.AutomationId="AppPackageMetadataDetails" Text="{Binding AppPackageMetadataDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="130" MaxHeight="380" VerticalScrollBarVisibility="Auto" Background="#171C27" Foreground="#ECF1FB" BorderBrush="#35435A" Padding="8" AutomationProperties.Name="Catalog-reported publisher, description, license and release notes, unverified plain text"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Windows software / unclassified offers" FontSize="18" Margin="0,18,0,0"/>
            <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding WindowsSoftwareMessage}" Style="{StaticResource Caption}"/>
            </ScrollViewer>
            <ContentControl Content="{Binding WindowsSoftwareRows}" ContentTemplate="{StaticResource RowsTemplate}" Height="170"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
