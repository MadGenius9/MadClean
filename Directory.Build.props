<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Deterministic>true</Deterministic>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!-- Publishing adds runtime/linker build tooling; keep that graph separate from normal development. -->
        <NuGetLockFilePath Condition="'$(MadCleanPackage)' == 'true'">$(MSBuildProjectDirectory)/packages.win-x64.lock.json</NuGetLockFilePath>
    </PropertyGroup>
</Project>
